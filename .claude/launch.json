{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "env",
      "runtimeArgs": ["PORT=8081", "go", "-C", "backend", "run", "./cmd/server"],
      "port": 8081
    },
    {
      "name": "frontend",
      "runtimeExecutable": "env",
      "runtimeArgs": ["API_URL=http://localhost:8081", "npm", "--prefix", "frontend", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
